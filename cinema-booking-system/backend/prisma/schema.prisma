generator client { provider = "prisma-client-js" }
datasource db { provider = "mysql" url = env("DATABASE_URL") }

enum MovieStatus { NOW_SHOWING COMING_SOON ARCHIVED }
enum SeatType { STANDARD PREMIUM VIP ACCESSIBLE }
enum ShowSeatStatus { AVAILABLE BOOKED DISABLED }
enum BookingStatus { PENDING CONFIRMED CANCELLED REFUNDED EXPIRED }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }
enum PaymentMethod { CARD CASH WALLET ONLINE }
enum TicketStatus { VALID USED CANCELLED EXPIRED }
enum NotificationChannel { EMAIL IN_APP PUSH }

model Role { id String @id @default(cuid()) name String @unique description String? users User[] permissions RolePermission[] createdAt DateTime @default(now()) }
model Permission { id String @id @default(cuid()) key String @unique description String? roles RolePermission[] }
model RolePermission { roleId String permissionId String role Role @relation(fields:[roleId], references:[id], onDelete: Cascade) permission Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade) @@id([roleId, permissionId]) }
model User { id String @id @default(cuid()) name String email String @unique phone String? passwordHash String roleId String role Role @relation(fields:[roleId], references:[id]) avatarUrl String? blockedAt DateTime? refreshTokenHash String? bookings Booking[] reviews Review[] notifications Notification[] auditLogs AuditLog[] lockedSeats ShowSeat[] usedTickets Ticket[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Cinema { id String @id @default(cuid()) name String slug String @unique address String city String country String latitude Decimal? longitude Decimal? phone String? email String? premium Boolean @default(false) halls Hall[] shows Show[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Hall { id String @id @default(cuid()) cinemaId String cinema Cinema @relation(fields:[cinemaId], references:[id], onDelete: Cascade) name String screenType String @default("2D") rowsCount Int seatsPerRow Int seats Seat[] shows Show[] createdAt DateTime @default(now()) @@unique([cinemaId, name]) }
model Seat { id String @id @default(cuid()) hallId String hall Hall @relation(fields:[hallId], references:[id], onDelete: Cascade) row String number Int type SeatType @default(STANDARD) enabled Boolean @default(true) showSeats ShowSeat[] @@unique([hallId, row, number]) }
model Movie { id String @id @default(cuid()) title String slug String @unique synopsis String @db.Text language String durationMinutes Int ageRating String status MovieStatus @default(NOW_SHOWING) rating Decimal @default(0) trailerUrl String? posterUrl String? bannerUrl String? castJson Json? crewJson Json? publishedAt DateTime? images MovieImage[] genres MovieGenre[] shows Show[] reviews Review[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model MovieImage { id String @id @default(cuid()) movieId String movie Movie @relation(fields:[movieId], references:[id], onDelete: Cascade) url String alt String? kind String sortOrder Int @default(0) }
model Genre { id String @id @default(cuid()) name String @unique slug String @unique movies MovieGenre[] }
model MovieGenre { movieId String genreId String movie Movie @relation(fields:[movieId], references:[id], onDelete: Cascade) genre Genre @relation(fields:[genreId], references:[id], onDelete: Cascade) @@id([movieId, genreId]) }
model Show { id String @id @default(cuid()) movieId String cinemaId String hallId String movie Movie @relation(fields:[movieId], references:[id]) cinema Cinema @relation(fields:[cinemaId], references:[id]) hall Hall @relation(fields:[hallId], references:[id]) startsAt DateTime endsAt DateTime basePrice Decimal status String @default("ACTIVE") seats ShowSeat[] bookings Booking[] createdAt DateTime @default(now()) @@index([movieId, startsAt]) }
model ShowSeat { id String @id @default(cuid()) showId String seatId String show Show @relation(fields:[showId], references:[id], onDelete: Cascade) seat Seat @relation(fields:[seatId], references:[id]) status ShowSeatStatus @default(AVAILABLE) price Decimal lockedByUserId String? lockedByUser User? @relation(fields:[lockedByUserId], references:[id]) lockedUntil DateTime? bookingItems BookingItem[] @@unique([showId, seatId]) @@index([showId, status, lockedUntil]) }
model Booking { id String @id @default(cuid()) bookingCode String @unique userId String showId String user User @relation(fields:[userId], references:[id]) show Show @relation(fields:[showId], references:[id]) status BookingStatus @default(PENDING) subtotal Decimal tax Decimal discount Decimal @default(0) total Decimal couponId String? coupon Coupon? @relation(fields:[couponId], references:[id]) items BookingItem[] ticket Ticket? payment Payment? foodOrders FoodOrder[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId, status]) }
model BookingItem { id String @id @default(cuid()) bookingId String showSeatId String booking Booking @relation(fields:[bookingId], references:[id], onDelete: Cascade) showSeat ShowSeat @relation(fields:[showSeatId], references:[id]) seatLabel String price Decimal @@unique([bookingId, showSeatId]) }
model Ticket { id String @id @default(cuid()) bookingId String @unique booking Booking @relation(fields:[bookingId], references:[id], onDelete: Cascade) qrCode String @unique qrCodeUrl String @db.Text status TicketStatus @default(VALID) usedAt DateTime? usedByUserId String? usedBy User? @relation(fields:[usedByUserId], references:[id]) createdAt DateTime @default(now()) }
model Payment { id String @id @default(cuid()) bookingId String @unique booking Booking @relation(fields:[bookingId], references:[id], onDelete: Cascade) amount Decimal method PaymentMethod status PaymentStatus @default(PENDING) providerReference String? metadata Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model FoodCategory { id String @id @default(cuid()) name String slug String @unique sortOrder Int @default(0) items FoodItem[] }
model FoodItem { id String @id @default(cuid()) categoryId String category FoodCategory @relation(fields:[categoryId], references:[id]) name String description String? imageUrl String? price Decimal stock Int @default(0) enabled Boolean @default(true) combo Boolean @default(false) orderItems FoodOrderItem[] }
model FoodOrder { id String @id @default(cuid()) bookingId String booking Booking @relation(fields:[bookingId], references:[id], onDelete: Cascade) status String @default("PENDING") total Decimal items FoodOrderItem[] createdAt DateTime @default(now()) }
model FoodOrderItem { id String @id @default(cuid()) foodOrderId String foodItemId String foodOrder FoodOrder @relation(fields:[foodOrderId], references:[id], onDelete: Cascade) foodItem FoodItem @relation(fields:[foodItemId], references:[id]) quantity Int price Decimal }
model Banner { id String @id @default(cuid()) title String subtitle String? imageUrl String ctaLabel String? ctaUrl String? placement String active Boolean @default(true) sortOrder Int @default(0) }
model Notification { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId], references:[id], onDelete: Cascade) channel NotificationChannel title String body String @db.Text readAt DateTime? metadata Json? createdAt DateTime @default(now()) }
model Coupon { id String @id @default(cuid()) code String @unique description String? discountType String discountValue Decimal startsAt DateTime endsAt DateTime maxUses Int? usedCount Int @default(0) bookings Booking[] }
model Review { id String @id @default(cuid()) userId String movieId String user User @relation(fields:[userId], references:[id]) movie Movie @relation(fields:[movieId], references:[id], onDelete: Cascade) rating Int comment String? createdAt DateTime @default(now()) @@unique([userId, movieId]) }
model AuditLog { id String @id @default(cuid()) actorUserId String? actor User? @relation(fields:[actorUserId], references:[id]) action String entity String entityId String? metadata Json? ipAddress String? createdAt DateTime @default(now()) }
model Setting { id String @id @default(cuid()) key String @unique value Json description String? updatedAt DateTime @updatedAt }
